{
  "note": "RFC 4180 cases and what they parse to; each is also fed in pieces of every size from 1 character.",
  "cases": [
    {
      "name": "simple",
      "input": "a,b,c\r\n1,2,3\r\n",
      "rows": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "1",
          "2",
          "3"
        ]
      ]
    },
    {
      "name": "no final line break",
      "input": "a,b\n1,2",
      "rows": [
        [
          "a",
          "b"
        ],
        [
          "1",
          "2"
        ]
      ]
    },
    {
      "name": "LF and CR line ends",
      "input": "a\nb\rc\r\nd",
      "rows": [
        [
          "a"
        ],
        [
          "b"
        ],
        [
          "c"
        ],
        [
          "d"
        ]
      ]
    },
    {
      "name": "quoted fields",
      "input": "\"a\",\"b c\",d\n",
      "rows": [
        [
          "a",
          "b c",
          "d"
        ]
      ]
    },
    {
      "name": "quotes doubled inside quotes",
      "input": "\"say \"\"hi\"\"\",x\n",
      "rows": [
        [
          "say \"hi\"",
          "x"
        ]
      ]
    },
    {
      "name": "line breaks inside quotes",
      "input": "\"line 1\nline 2\",x\r\n\"a\r\nb\",y\n",
      "rows": [
        [
          "line 1\nline 2",
          "x"
        ],
        [
          "a\r\nb",
          "y"
        ]
      ]
    },
    {
      "name": "delimiters inside quotes",
      "input": "\"a,b\",c\n",
      "rows": [
        [
          "a,b",
          "c"
        ]
      ]
    },
    {
      "name": "empty fields",
      "input": ",a,,\n,,,\n",
      "rows": [
        [
          "",
          "a",
          "",
          ""
        ],
        [
          "",
          "",
          "",
          ""
        ]
      ]
    },
    {
      "name": "empty quoted field",
      "input": "\"\",x\n",
      "rows": [
        [
          "",
          "x"
        ]
      ]
    },
    {
      "name": "UTF-8 BOM",
      "input": "﻿name,age\nAda,36\n",
      "rows": [
        [
          "name",
          "age"
        ],
        [
          "Ada",
          "36"
        ]
      ]
    },
    {
      "name": "BOM before a quoted field",
      "input": "﻿\"q\",1\n",
      "rows": [
        [
          "q",
          "1"
        ]
      ]
    },
    {
      "name": "semicolons sniffed",
      "input": "a;b;c\n1,5;2,5;3\n",
      "rows": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "1,5",
          "2,5",
          "3"
        ]
      ]
    },
    {
      "name": "tabs sniffed",
      "input": "a\tb\n1\t2\n",
      "rows": [
        [
          "a",
          "b"
        ],
        [
          "1",
          "2"
        ]
      ]
    },
    {
      "name": "pipes sniffed",
      "input": "a|b|c\n1|2|3\n",
      "rows": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "1",
          "2",
          "3"
        ]
      ]
    },
    {
      "name": "commas inside quotes do not fool the sniffer",
      "input": "\"x,y\";z\n\"p,q\";r\n",
      "rows": [
        [
          "x,y",
          "z"
        ],
        [
          "p,q",
          "r"
        ]
      ]
    },
    {
      "name": "ragged rows",
      "input": "a,b,c\n1\n1,2\n",
      "rows": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "1"
        ],
        [
          "1",
          "2"
        ]
      ]
    },
    {
      "name": "unicode",
      "input": "é,日本,🙂\n",
      "rows": [
        [
          "é",
          "日本",
          "🙂"
        ]
      ]
    },
    {
      "name": "spaces kept",
      "input": " a , b \n",
      "rows": [
