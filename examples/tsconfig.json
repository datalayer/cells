// The examples, type-checked on the package's source.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"],
    "paths": {
      "@datalayer/cells": ["../src/index.ts"],
      "@datalayer/cells/csv": ["../src/csv/index.ts"],
      "@datalayer/cells/chrome": ["../src/chrome/index.ts"],
      "@datalayer/cells/xlsx": ["../src/xlsx/index.ts"],
      "@datalayer/cells/charts": ["../src/charts/index.ts"],
      "@datalayer/cells/collab": ["../src/collab/index.ts"],
      "@datalayer/cells/plugin": ["../src/plugin/index.ts"],
      "@datalayer/cells/jupyter": ["../src/jupyter/index.tsx"]
    }
  },
  "include": ["src", "vite.config.ts", "../src"],
  "exclude": ["../src/**/__tests__/**"]
}
