// Typecheck everything, tests and benches included.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // A test may mount an example page (the charts demo): the page's imports resolve to the source.
    "paths": {
      "@datalayer/cells": ["./src/index.ts"],
      "@datalayer/cells/csv": ["./src/csv/index.ts"],
      "@datalayer/cells/chrome": ["./src/chrome/index.ts"],
      "@datalayer/cells/xlsx": ["./src/xlsx/index.ts"],
      "@datalayer/cells/charts": ["./src/charts/index.ts"],
      "@datalayer/cells/collab": ["./src/collab/index.ts"],
      "@datalayer/cells/jupyter": ["./src/jupyter/index.tsx"]
    }
  },
  "include": [
    "src",
    "bench",
    "e2e",
    "vitest.config.ts",
    "vitest.react18.config.ts",
    "playwright.config.ts"
  ],
  "exclude": []
}
