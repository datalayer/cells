{
  "name": "@datalayer/cells",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/datalayer/cells.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "A spreadsheet drawn on canvas, exposed as a React component, over a headless model that also runs in Node and in workers.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./csv": {
      "types": "./lib/csv/index.d.ts",
      "import": "./lib/csv/index.js"
    },
    "./xlsx": {
      "types": "./lib/xlsx/index.d.ts",
      "import": "./lib/xlsx/index.js"
    },
    "./collab": {
      "types": "./lib/collab/index.d.ts",
      "import": "./lib/collab/index.js"
    },
    "./chrome": {
      "types": "./lib/chrome/index.d.ts",
      "import": "./lib/chrome/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin/index.d.ts",
      "import": "./lib/plugin/index.js"
    },
    "./style/cells.css": "./style/cells.css"
  },
  "typesVersions": {
    "*": {
      "core": [
        "lib/core/index.d.ts"
      ],
      "csv": [
        "lib/csv/index.d.ts"
      ],
      "xlsx": [
        "lib/xlsx/index.d.ts"
      ],
      "collab": [
        "lib/collab/index.d.ts"
      ],
      "chrome": [
        "lib/chrome/index.d.ts"
      ],
      "plugin": [
        "lib/plugin/index.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "style"
  ],
  "keywords": [
    "datalayer",
    "spreadsheet",
    "canvas",
    "react",
    "formulas",
    "grid"
  ],
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "build": "tsc -p tsconfig.json",
    "build:lib": "tsc -p tsconfig.json",
    "check:node": "node scripts/check-node-load.mjs",
    "clean": "rm -rf lib",
    "e2e": "playwright test",
    "examples": "node scripts/examples.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && node scripts/check-headers.mjs",
    "size": "node scripts/size.mjs",
    "test": "vitest run && vitest run -c vitest.react18.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p examples/tsconfig.json",
    "watch:lib": "tsc -w -p tsconfig.json",
    "functions-page": "node scripts/functions-page.mjs"
  },
  "peerDependencies": {
    "@datalayer/primer-addons": "^1.0.44",
    "@datalayer/reactor": "^1.3.2",
    "loro-crdt": "^1.16.4",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@datalayer/primer-addons": "^1.0.44",
    "@datalayer/reactor": "^1.3.2",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24",
    "@types/rbush": "^4.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "loro-crdt": "^1.16.4",
    "prettier": "^3.6.2",
    "react": "19.2.8",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.2.8",
    "react-dom-18": "npm:react-dom@18.3.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "@datalayer/primer-addons": {
      "optional": true
    },
    "loro-crdt": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "rbush": "^4.0.1"
  }
}
