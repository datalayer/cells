{
  "name": "@datalayer/cells-docusaurus",
  "version": "1.0.0",
  "description": "Datalayer Cells in a Docusaurus site: a plugin that checks the site's .cells.json and .csv files at build time, and a <Cells> component that shows one as a live sheet in an MDX page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/datalayer/cells.git",
    "directory": "integrations/docusaurus"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./check": {
      "types": "./lib/check.d.ts",
      "import": "./lib/check.js",
      "default": "./lib/check.js"
    },
    "./client": {
      "types": "./lib/client/CellsClient.d.ts",
      "import": "./lib/client/CellsClient.js",
      "default": "./lib/client/CellsClient.js"
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "datalayer",
    "cells",
    "spreadsheet",
    "docusaurus",
    "docusaurus-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "test": "vitest run --root ."
  },
  "peerDependencies": {
    "@datalayer/cells": "^1.0.0",
    "@datalayer/primer-addons": "^1.0.44",
    "@datalayer/reactor": "^1.3.2",
    "@docusaurus/core": "^3.5.0",
    "@primer/octicons-react": "^19.35.0",
    "@primer/react": "^37.31.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
